# ===========================================
# AI Trading Assistant - Environment Variables
# ===========================================

# Application
ENVIRONMENT=development
DEBUG=true
API_VERSION=v1
APP_NAME="AI Trading Assistant"

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://chart-analytics-theta.vercel.app

# Database - Firestore (optional, uses local JSON fallback)
# FIRESTORE_EMULATOR_HOST=localhost:8080
FIRESTORE_PROJECT_ID=trading-assistant-dev
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# Celery (optional, for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ===========================================
# Angel One SmartAPI - Real-time Market Data
# ===========================================
# Get your API key from: https://www.angelone.in/smart-api
# Enable 2FA and get TOTP secret from your Angel One app

# Set to true to enable Angel One for real-time data
ANGEL_ONE_ENABLED=false

# Your Angel One SmartAPI credentials
ANGEL_ONE_API_KEY=your_api_key_here
ANGEL_ONE_CLIENT_CODE=your_client_code
ANGEL_ONE_PASSWORD=your_password

# TOTP Secret for 2FA (generate from Angel One app)
# You can get this by enabling 2FA in your Angel One account
# Once enabled, you cannot login without TOTP
ANGEL_ONE_TOTP_SECRET=your_totp_secret_here

# ===========================================
# Zerodha Kite Connect - Real-time Market Data
# ===========================================
# Get your API key from: https://developers.kite.trade
# Generate access token via OAuth flow

# Set to true to enable Kite Connect for real-time data
KITE_CONNECT_ENABLED=false

# Your Kite Connect credentials
KITE_CONNECT_API_KEY=your_api_key_here
KITE_CONNECT_ACCESS_TOKEN=your_access_token_here

# Note: Kite Connect is FREE for personal/non-commercial use only
# For commercial use, you need Kite Connect paid plan (₹500/month)

# ===========================================
# Alternative Data Sources (if Angel One not used)
# ===========================================

# NSE India API (limited access)
NSE_API_KEY=
NSE_API_URL=https://api.nseindia.com

# Yahoo Finance
YAHOO_FINANCE_URL=https://query1.finance.yahoo.com

# ===========================================
# AI/LLM Settings
# ===========================================
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4-turbo
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# ===========================================
# Authentication
# ===========================================
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Telegram Bot (optional)
# ===========================================
TELEGRAM_BOT_TOKEN=

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===========================================
# Git (agent push credentials)
# ===========================================
# Classic PAT with `repo` scope, used by the agent to push branches.
# Keep this in backend/.env (gitignored), NEVER in tracked files.
GITHUB_TOKEN=your_github_personal_access_token_here
